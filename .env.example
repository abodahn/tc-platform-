# ============================================================
#  TC Platform — Environment Configuration (copy to .env)
# ============================================================
# Never commit the real .env file. Keep production secrets out of source control.

# --- Core ---
TC_ENV=development
TC_SECRET_KEY=change-this-to-a-long-random-string-in-production
TC_HOST=0.0.0.0
TC_PORT=7000
TC_DEBUG=true

# --- Database ---
# Local dev: leave blank -> uses the SQLite file platform.db.
# Production (Render): DATABASE_URL is injected automatically from the managed
# PostgreSQL database (you do NOT set it here). To test the Postgres path locally:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/tc_platform
DATABASE_URL=
TC_DATABASE_URL=

# --- Render / deployment (set on Render, not here) ---
# PORT        -> injected by Render (gunicorn binds 0.0.0.0:$PORT)
# TC_DATA_DIR -> writable dir for uploads/backups (e.g. /var/data on a disk,
#                /tmp/tc-data on free tier). Defaults to the project folder locally.
TC_DATA_DIR=

# --- Session / Security ---
TC_SESSION_MINUTES=120

# --- Default Super Admin (created on first run only) ---
TC_ADMIN_USER=admin
TC_ADMIN_PASSWORD=Admin@12345

# --- Integrated systems base host (used to build default URLs) ---
# In production point this at the server IP, e.g. 10.100.1.13
TC_INTEGRATION_HOST=127.0.0.1

# --- Health check tuning ---
TC_HEALTH_TIMEOUT=3
