# TC Platform
.env
.secret_key
/logs/
*.db
*.sqlite3
__pycache__/
*.pyc
.venv/
venv/
/backups/
/instance/
/uploads/
.pytest_cache/
.ruff_cache/
screenshots/
*.log

# never commit the SSO shared secret or the local preview runner
.tc_sso_secret
preview_run.py
preview.db

# local tooling / editor state
.claude/

# agent working files — never part of the app
scratchpad/
_out.pdf
_stress.pdf

# Database backups. '*.db' does not match a name that ENDS in something else,
# which is how platform.db.pre-cleanup-bak (9.4 MB, 737 password hashes, 677
# staff email addresses) got committed to a PUBLIC repository twice.
platform.db.*
*.db.*
*-bak
*.bak

# Beta server console capture — local diagnostics, never committed.
beta-server*.log
