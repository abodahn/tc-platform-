{
  "wsh.eyebrow": {
    "en": "Wet processing · Wash & finishing",
    "ar": "التجهيز الرطب · الغسيل والتشطيب",
    "tr": "Islak işlem · Yıkama ve terbiye"
  },
  "wsh.dash.title": {
    "en": "Wash recipe library",
    "ar": "مكتبة وصفات الغسيل",
    "tr": "Yıkama reçete kütüphanesi"
  },
  "wsh.dash.sub": {
    "en": "Versioned wash recipes, chemical dosing and batch traceability — so a shade can be reproduced months later.",
    "ar": "وصفات غسيل بإصدارات، وجرعات المواد الكيميائية، وتتبّع الدفعات — حتى يمكن إعادة إنتاج درجة اللون بعد أشهر.",
    "tr": "Versiyonlu yıkama reçeteleri, kimyasal dozajı ve parti izlenebilirliği — bir ton aylar sonra yeniden üretilebilsin."
  },
  "wsh.dash.recent": {
    "en": "Recent batches",
    "ar": "أحدث الدفعات",
    "tr": "Son partiler"
  },
  "wsh.dash.dips": {
    "en": "Shade sign-off queue",
    "ar": "قائمة اعتماد درجة اللون",
    "tr": "Ton onay kuyruğu"
  },
  "wsh.recipes.sub": {
    "en": "One row per recipe family. Steps and chemicals live on a version, never on the family.",
    "ar": "سطر واحد لكل عائلة وصفات. الخطوات والمواد الكيميائية تتبع الإصدار، لا العائلة.",
    "tr": "Her reçete ailesi için bir satır. Adımlar ve kimyasallar aileye değil, versiyona aittir."
  },
  "wsh.recipes.hint": {
    "en": "A draft version 1 is created automatically.",
    "ar": "يتم إنشاء الإصدار 1 كمسودة تلقائيًا.",
    "tr": "Taslak versiyon 1 otomatik olarak oluşturulur."
  },
  "wsh.batches.title": {
    "en": "Wash batches",
    "ar": "دفعات الغسيل",
    "tr": "Yıkama partileri"
  },
  "wsh.batches.sub": {
    "en": "Every lot records the exact recipe version it ran — that is what makes the shade reproducible later.",
    "ar": "كل دفعة تسجّل إصدار الوصفة الذي شُغّل بالضبط — وهذا ما يجعل درجة اللون قابلة للتكرار لاحقًا.",
    "tr": "Her parti, çalıştırdığı reçete versiyonunu birebir kaydeder — tonu sonradan tekrarlanabilir kılan budur."
  },
  "wsh.batches.hint": {
    "en": "Actuals outside tolerance are flagged and raise a bell alert.",
    "ar": "القيم الفعلية الخارجة عن حدود السماح يتم تمييزها وترفع تنبيهًا في الجرس.",
    "tr": "Tolerans dışı gerçekleşen değerler işaretlenir ve zil uyarısı oluşturur."
  },
  "wsh.dips.title": {
    "en": "Lab dips & shade approval",
    "ar": "عيّنات اللون المخبرية واعتماد درجة اللون",
    "tr": "Laboratuvar numuneleri ve ton onayı"
  },
  "wsh.dips.sub": {
    "en": "A recipe version cannot go to bulk until one of its own lab dips is approved.",
    "ar": "لا يمكن لإصدار الوصفة الانتقال إلى الإنتاج الكمي قبل اعتماد إحدى عيّناته المخبرية.",
    "tr": "Bir reçete versiyonu, kendi laboratuvar numunelerinden biri onaylanmadan seri üretime geçemez."
  },
  "wsh.detail.versions_count": {
    "en": "versions",
    "ar": "الإصدارات",
    "tr": "versiyonlar"
  },
  "wsh.detail.pick_version": {
    "en": "Version",
    "ar": "الإصدار",
    "tr": "Versiyon"
  },
  "wsh.detail.version": {
    "en": "Version",
    "ar": "الإصدار",
    "tr": "Versiyon"
  },
  "wsh.detail.gate": {
    "en": "A version can only be approved for bulk once one of its own lab dips is approved. Approving it retires the previous bulk standard.",
    "ar": "لا يُعتمد الإصدار للإنتاج الكمي إلا بعد اعتماد إحدى عيّناته المخبرية. واعتماده يسحب المعيار الكمي السابق من الخدمة.",
    "tr": "Bir versiyon, ancak kendi laboratuvar numunelerinden biri onaylandığında seri üretim için onaylanabilir. Onaylanması, önceki seri üretim standardını devre dışı bırakır."
  },
  "wsh.detail.impact": {
    "en": "Environmental indicator",
    "ar": "المؤشر البيئي",
    "tr": "Çevresel gösterge"
  },
  "wsh.detail.impact_note": {
    "en": "Internal indicator only — not a certified EIM score. Water, energy and chemical intensity per kg of goods, each capped at 100 and averaged. Lower is better.",
    "ar": "مؤشر داخلي فقط — وليس درجة EIM معتمدة. كثافة الماء والطاقة والمواد الكيميائية لكل كجم من البضاعة، كل منها محدود بـ 100 ثم يُحسب المتوسط. الأقل أفضل.",
    "tr": "Yalnızca dahili bir göstergedir — sertifikalı bir EIM puanı değildir. Kilogram mal başına su, enerji ve kimyasal yoğunluğu; her biri 100 ile sınırlanıp ortalaması alınır. Düşük olan daha iyidir."
  },
  "wsh.detail.steps": {
    "en": "Steps & chemical dosing",
    "ar": "الخطوات وجرعات المواد الكيميائية",
    "tr": "Adımlar ve kimyasal dozajı"
